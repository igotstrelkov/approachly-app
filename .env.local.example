# Copy to .env.local and fill in. Never commit .env.local.

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional custom routes (defaults use Clerk modals):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Convex (populated by `npx convex dev`) ---
NEXT_PUBLIC_CONVEX_URL=https://xxxx.convex.cloud

# NOTE: CLERK_JWT_ISSUER_DOMAIN is set in the CONVEX dashboard
# (Settings → Environment Variables), NOT here. Value = your Clerk Issuer URL,
# e.g. https://your-app.clerk.accounts.dev
